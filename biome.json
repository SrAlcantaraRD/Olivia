{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "vcs": {
    "enabled": true,
    "defaultBranch": "main",
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!node_modules",
      "!build",
      "!dist",
      "!.vscode",
      "!coverage",
      "!uniwind.d.ts",
      "!src/global.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off",
        "noUnusedFunctionParameters": "off",
        "noUnknownTypeSelector": "off",
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":PACKAGE:",
              ":PACKAGE_WITH_PROTOCOL:",
              ":NODE:",
              ":BLANK_LINE:",
              "@/domain",
              ":BLANK_LINE:",
              "@/tests",
              ":BLANK_LINE:",
              "./",
              ":BLANK_LINE:",
              "../"
            ]
          }
        }
      }
    }
  }
}
