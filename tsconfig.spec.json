{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["jest", "node"]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
