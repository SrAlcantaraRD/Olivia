{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.sortMembers": "explicit",
    "source.biome": "always",
    "source.removeUnused.ts": "always"
  },
  "files.associations": {
    "*.css": "tailwindcss",
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName"
  ],
  "cSpell.words": [
    "heroui",
    "Nativewind"
  ],
}
