{
  "name": "tfg",
  "main": "expo-router/entry",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web -c",
    "lint": "expo lint",
    "publish": "eas update --branch main --message 'Preview release'",
    "build:android:development": "eas build --platform android --profile development --message \"Development build\"",
    "build:ios:development": "eas build --platform ios --profile development --message \"Development build\"",
    "build:android:production": "eas build --platform android --profile production --message \"Production build\"",
    "build:ios:production": "eas build --platform ios --profile production --message \"Production build\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "e2e:build:ios:debug": "detox build --configuration ios.sim.debug",
    "e2e:test:ios:debug": "detox test --configuration ios.sim.debug",
    "e2e:build:ios": "detox build --configuration ios.sim.release",
    "e2e:test:ios": "detox test --configuration ios.sim.release",
    "e2e:build:android:debug": "detox build --configuration android.emu.debug",
    "e2e:test:android:debug": "detox test --configuration android.emu.debug",
    "e2e:build:android": "detox build --configuration android.emu.release",
    "e2e:test:android": "detox test --configuration android.emu.release",
    "biome:format": "npx @biomejs/biome format --write ./",
    "biome:lint": "npx @biomejs/biome lint --write ./",
    "biome:check": "npx @biomejs/biome check --write ./",
    "db:generate": "drizzle-kit generate --config src/database/drizzle.config.ts",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.spec.json --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/flash-list": "2.3.2",
    "buffer": "^6.0.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "^58.0.10",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "^58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linear-gradient": "^58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "heroui-native": "^1.0.11",
    "i18next": "^26.5.4",
    "intl-pluralrules": "^2.0.1",
    "pako": "^3.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-logs": "^5.6.0",
    "react-native-mmkv": "4.3.2",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "^9.0.9",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-tab-view": "^4.3.4",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "uniwind": "^1.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@config-plugins/detox": "^11.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/pako": "^3.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "detox": "^20.51.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-circus": "~30.5.2",
    "jest-expo": "~58.0.12",
    "postcss": "^8.5.31",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "write-file-atomic": "^8.0.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
