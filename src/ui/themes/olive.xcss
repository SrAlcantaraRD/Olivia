/* themes/olive.css */
@layer theme {
  :root {
    @variant light {
      /* Base */
      --background: oklch(0.98 0 0);
      --foreground: oklch(0.15 0 0);
      --surface: oklch(0.96 0 0);
      --surface-foreground: oklch(0.15 0 0);
      --overlay: oklch(1 0 0);
      --overlay-foreground: oklch(0.15 0 0);

      /* Muted */
      --muted: oklch(0.55 0 0);
      --muted-foreground: oklch(0.35 0 0);

      /* Default */
      --default: oklch(0.92 0 0);
      --default-foreground: oklch(0.15 0 0);

      /* Accent (primary) */
      --accent: oklch(0.6 0.25 250);
      --accent-hover: oklch(0.55 0.25 250);
      --accent-soft: oklch(0.92 0.05 250);
      --accent-foreground: oklch(0.98 0 0);

      /* States */
      --success: oklch(0.65 0.2 145);
      --success-foreground: oklch(0.98 0 0);
      --warning: oklch(0.75 0.15 85);
      --warning-foreground: oklch(0.15 0 0);
      --danger: oklch(0.6 0.22 25);
      --danger-foreground: oklch(0.98 0 0);

      /* Warm (secundarios) */
      --warm-1: oklch(0.98 0.02 70);
      --warm-2: oklch(0.95 0.05 40);
      --warm-3: oklch(0.85 0.1 50);

      /* Fields */
      --field-background: oklch(1 0 0);
      --field-border: oklch(0.85 0 0);
      --field-placeholder: oklch(0.6 0 0);
      --field-foreground: oklch(0.15 0 0);

      /* Misc */
      --border: oklch(0.85 0 0);
      --divider: oklch(0.9 0 0);
      --link: var(--accent);

      /* Semantic required by Uniwind */
      --color-background: var(--background);
      --color-foreground: var(--foreground);
      --color-primary: var(--accent);
      --color-gray: var(--muted);
      --color-typography: var(--foreground);
      --color-card: var(--surface);
      --color-border: var(--divider);

      /* Segmented controls */
      --segment: var(--surface);
      --segment-foreground: var(--surface-foreground);

      /* Radius */
      --radius: 0.5rem;
    }

    @variant dark {
      /* Base */
      --background: oklch(0.15 0 0);
      --foreground: oklch(0.97 0 0);
      --surface: oklch(0.18 0 0);
      --surface-foreground: oklch(0.94 0 0);
      --overlay: oklch(0.23 0 0);
      --overlay-foreground: oklch(0.94 0 0);

      /* Muted */
      --muted: oklch(0.55 0 0);
      --muted-foreground: oklch(0.75 0 0);

      /* Default */
      --default: oklch(0.25 0 0);
      --default-foreground: oklch(0.95 0 0);

      /* Accent (primary) */
      --accent: oklch(0.65 0.25 250);
      --accent-hover: oklch(0.6 0.25 250);
      --accent-soft: oklch(0.22 0.05 250);
      --accent-foreground: oklch(0.98 0 0);

      /* States */
      --success: oklch(0.7 0.2 145);
      --success-foreground: oklch(0.15 0 0);
      --warning: oklch(0.75 0.15 85);
      --warning-foreground: oklch(0.15 0 0);
      --danger: oklch(0.65 0.22 25);
      --danger-foreground: oklch(0.98 0 0);

      /* Warm (secundarios) */
      --warm-1: oklch(0.85 0.02 70);
      --warm-2: oklch(0.75 0.05 40);
      --warm-3: oklch(0.6 0.1 50);

      /* Fields */
      --field-background: oklch(0.13 0 0);
      --field-border: oklch(0.28 0 0);
      --field-placeholder: oklch(0.58 0 0);
      --field-foreground: oklch(0.92 0 0);

      /* Misc */
      --border: oklch(0.28 0 0);
      --divider: oklch(0.32 0 0);
      --link: var(--accent);

      /* Semantic required by Uniwind */
      --color-background: var(--background);
      --color-foreground: var(--foreground);
      --color-primary: var(--accent);
      --color-gray: var(--muted);
      --color-typography: var(--foreground);
      --color-card: var(--surface);
      --color-border: var(--divider);

      /* Segmented controls */
      --segment: var(--surface);
      --segment-foreground: var(--surface-foreground);

      /* Radius */
      --radius: 0.5rem;
    }
  }
}
